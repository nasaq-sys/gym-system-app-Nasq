AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TOKEN=your_airtable_personal_access_token
SESSION_SECRET=your_long_random_session_secret

# Upstash Redis (For Idempotency, Caching & Metrics)
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:info@yourdomain.com

# Web Push Cryptographic Receipt Token Signing Secret
PUSH_RECEIPT_SIGNING_SECRET=your_push_receipt_secret

# D7 Networks SMS Gateway Integration
D7_API_TOKEN=your_d7_api_token
D7_ORIGINATOR=UltraGym
D7_SENDER_ID=UltraGym
D7_SMS_ENABLED=true
APP_PUBLIC_URL=https://your-domain.com
D7_SMS_COST_PER_SEGMENT=0.05

# Cron Execution Secret
CRON_SECRET=your_cron_secret_here

# Active Payment Gateway Provider
PAYMENT_PROVIDER=myfatoorah
PAYMENT_MODE=sandbox

# MyFatoorah Configuration
MYFATOORAH_API_TOKEN=your_myfatoorah_token
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_TEST_MODE=true

# Inactive / Disabled Gateways
PAYTABS_TEST_MODE=false
